{% assign postdir = page.date | date: "%Y-%m-%d" %}
{% assign image = include.image %}
{% assign caption = include.caption %}
{% assign cols = include.cols %}

{% if include.href %}
    {% assign href = include.href %}
{% else %}
    {% assign href = "" %}
{% endif %}


{% case cols %}
    {% when 1 %}
        {% assign class = "" %}
    {% when 2 %}
        {% assign class = "half" %}
    {% when 3 %}
        {% assign class = "third" %}
    {% else %}
        {% assign class = "" %}
{% endcase %}


<figure {% if class != "" %}class="{{ class }}"{% endif %}>
    {% if href != "" %}
        <a href="{{ href }}">
    {% else %}
        <a href="/assets/images/posts/{{ postdir }}/{{ image }}">
    {% endif %}
    <img align="center" src="/assets/images/posts/{{ postdir }}/{{ image }}" alt=""></a>
    <figcaption>{{ caption }}</figcaption>
</figure>



