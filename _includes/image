{% assign postdir = page.date | date: "%Y-%m-%d" %}
{% assign image = include.image %}
{% assign caption = include.caption %}
{% assign cols = include.cols %}

{% case cols %}
    {% when 1 %}
        {% assign class = "" %}
    {% when 2 %}
        {% assign class = "half" %}
    {% when 3 %}
        {% assign class = "third" %}
    {% else %}
        {% assign class = "" %}
{% endcase %}


<figure {% if class != "" %}class="{{ class }}"{% endif %}>
    <a href="{{ image }}"><img align="center" src="/assets/images/posts/{{ postdir }}/{{ image }}" alt=""></a>
    <figcaption>{{ caption }}</figcaption>
</figure>



